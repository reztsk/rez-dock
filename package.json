{
  "name": "rez-dock",
  "private": true,
  "version": "1.2.0",
  "description": "REZ — Dock Expo-Glass pour Windows (Tauri v2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "icons": "tauri icon assets/logo/rez-icon.svg -o src-tauri/icons",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
